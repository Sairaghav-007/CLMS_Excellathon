# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/clms_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345

# Server Port
PORT=8080

# JWT Authentication
JWT_SECRET=change-this-to-a-very-long-secret-key-1234567890
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AWS SES / S3 Configuration (Optional for cloud emails and video storage)
VITE_AWS_REGION=ap-southeast-2
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SES_SENDER_EMAIL=noreply@clms.com
VITE_EMAIL_API_URL=https://your-email-lambda-url/
